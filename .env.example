# Shared Supabase project ("kawabunga8's Project") — same one TOC-Dayplans,
# Course Hub, Report Card Tool, and Kawahoot use. Used for auth only. Get these
# from the Supabase dashboard (Project Settings → API Keys) — never commit
# real values here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
SUPABASE_SECRET_KEY=

# Course Hub API — the source of truth for courses and rosters. Group Maker
# proxies to this for all course/student data; get these from Course Hub.
COURSE_HUB_URL=
COURSE_HUB_API_KEY=
